# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Environment variables / secrets
.env
.env.*
!.env.example
*.pem
*.key
*token.json*
*credentials.json*
memory/test_credentials.md

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# Builds and caches
dist/
build/
out/
.next/
next-env.d.ts
*.tsbuildinfo
coverage/
.cache/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# IDE, editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local tooling
.emergent/
.chainlit
chainlit.md
.ac
.vercel

# Local dev object storage (uploads/reports)
backend/local_storage/

# Generated test reports
test_reports/

# Large original buyer PO workbook (23 MB, not used by the app;
